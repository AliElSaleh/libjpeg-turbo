TargetName %target

Assembly $TargetName
Type     static_lib

TitleName        libjpeg-turbo
Description      libjpeg API DLL
InternalName     jpeg$(jpeg_version)
Version          3.1.3
CompanyName      libjpeg-turbo
Copyright        Copyright 1991-%_date.year The libjpeg-turbo Project and many others

Compiler:windows cl
Compiler:unix    clang
Assembler        nasm

BuildDirectory            bin/$assembly
IntermediateDirectory     int/$assembly

SrcDir src

Jpeg16_Sources
[
    $SrcDir/jcapistd.c
    $SrcDir/jccolor.c
    $SrcDir/jcdiffct.c
    $SrcDir/jclossls.c
    $SrcDir/jcmainct.c
    $SrcDir/jcprepct.c
    $SrcDir/jcsample.c
    $SrcDir/jdapistd.c
    $SrcDir/jdcolor.c
    $SrcDir/jddiffct.c
    $SrcDir/jdlossls.c
    $SrcDir/jdmainct.c
    $SrcDir/jdpostct.c
    $SrcDir/jdsample.c
    $SrcDir/jutils.c
]

Jpeg12_Sources
[
    $Jpeg16_Sources
    $SrcDir/jccoefct.c
    $SrcDir/jcdctmgr.c
    $SrcDir/jdcoefct.c
    $SrcDir/jddctmgr.c
    $SrcDir/jdmerge.c
    $SrcDir/jfdctfst.c
    $SrcDir/jfdctint.c
    $SrcDir/jidctflt.c
    $SrcDir/jidctfst.c
    $SrcDir/jidctint.c
    $SrcDir/jidctred.c
    $SrcDir/jquant1.c
    $SrcDir/jquant2.c
    $SrcDir/jcarith.c
    $SrcDir/jaricom.c
    $SrcDir/jdarith.c
]

Jpeg_Sources
[
    $Jpeg12_Sources
    $SrcDir/jcapimin.c
    $SrcDir/jchuff.c
    $SrcDir/jcicc.c
    $SrcDir/jcinit.c
    $SrcDir/jclhuff.c
    $SrcDir/jcmarker.c
    $SrcDir/jcmaster.c
    $SrcDir/jcomapi.c
    $SrcDir/jcparam.c
    $SrcDir/jcphuff.c
    $SrcDir/jctrans.c
    $SrcDir/jdapimin.c
    $SrcDir/jdatadst.c
    $SrcDir/jdatasrc.c
    $SrcDir/jdhuff.c
    $SrcDir/jdicc.c
    $SrcDir/jdinput.c
    $SrcDir/jdlhuff.c
    $SrcDir/jdmarker.c
    $SrcDir/jdmaster.c
    $SrcDir/jdphuff.c
    $SrcDir/jdtrans.c
    $SrcDir/jerror.c
    $SrcDir/jfdctflt.c
    $SrcDir/jmemmgr.c
    $SrcDir/jmemnobs.c
    $SrcDir/jpeg_nbits.c
]

TurboJpeg_Sources
[
    $Jpeg_Sources
    $SrcDir/turbojpeg.c
    $SrcDir/transupp.c
    $SrcDir/jdatadst-tj.c
    $SrcDir/jdatasrc-tj.c
    $SrcDir/rdbmp.c
    $SrcDir/rdppm.c
    $SrcDir/wrbmp.c
    $SrcDir/wrppm.c
]

TurboJpeg12_Sources
[
    $Jpeg12_Sources
    $SrcDir/rdppm.c
    $SrcDir/wrppm.c
]

TurboJpeg16_Sources
[
    $Jpeg16_Sources
    $SrcDir/rdppm.c
    $SrcDir/wrppm.c
]

if !target                 SourceFiles $Jpeg_Sources        ; bits_jsample 8
if  target == jpeg         SourceFiles $Jpeg_Sources        ; bits_jsample 8
if  target == jpeg12       SourceFiles $Jpeg12_Sources      ; bits_jsample 8
if  target == jpeg16       SourceFiles $Jpeg16_Sources      ; bits_jsample 16
if  target == turbojpeg    SourceFiles $TurboJpeg_Sources   ; bits_jsample 8
if  target == turbojpeg12  SourceFiles $TurboJpeg12_Sources ; bits_jsample 8
if  target == turbojpeg16  SourceFiles $TurboJpeg16_Sources ; bits_jsample 16

if simd
{
    Defines WITH_SIMD

    SourceFiles $(SimdDir)/jsimd.c

    Assembler.Flags -Isimd/nasm -I$SimdDir
    if windows Assembler.Flags -DWIN64 -DWIN32 -D__x86_64__ -f win64

    if x64      SimdDir simd/x86_64
    if i386     SimdDir simd/i386
    if mips     SimdDir simd/mips
    if mips64   SimdDir simd/mips64
    if powerpc  SimdDir simd/powerpc

    SourceFiles
    [
        $(SimdDir)/jsimdcpu.asm
        $(SimdDir)/jfdctflt-sse.asm
        $(SimdDir)/jccolor-sse2.asm
        $(SimdDir)/jcgray-sse2.asm
        $(SimdDir)/jchuff-sse2.asm
        $(SimdDir)/jcphuff-sse2.asm
        $(SimdDir)/jcsample-sse2.asm
        $(SimdDir)/jdcolor-sse2.asm
        $(SimdDir)/jdmerge-sse2.asm
        $(SimdDir)/jdsample-sse2.asm
        $(SimdDir)/jfdctfst-sse2.asm
        $(SimdDir)/jfdctint-sse2.asm
        $(SimdDir)/jidctflt-sse2.asm
        $(SimdDir)/jidctfst-sse2.asm
        $(SimdDir)/jidctint-sse2.asm
        $(SimdDir)/jidctred-sse2.asm
        $(SimdDir)/jquantf-sse2.asm
        $(SimdDir)/jquanti-sse2.asm
        $(SimdDir)/jccolor-avx2.asm
        $(SimdDir)/jcgray-avx2.asm
        $(SimdDir)/jcsample-avx2.asm
        $(SimdDir)/jdcolor-avx2.asm
        $(SimdDir)/jdmerge-avx2.asm
        $(SimdDir)/jdsample-avx2.asm
        $(SimdDir)/jfdctint-avx2.asm
        $(SimdDir)/jidctint-avx2.asm
        $(SimdDir)/jquanti-avx2.asm
    ]
}

if !jpeg8 if !jpeg7       jpeg_version 62 ; jpeg_version_decimal 6.2
if jpeg8                  jpeg_version 80 ; jpeg_version_decimal 8.0
if jpeg7                  jpeg_version 70 ; jpeg_version_decimal 7.0

# TODO: fix this. not working
#"Emulating libjpeg API/ABI v% (WITH_JPEG7 = %, WITH_JPEG8 = %)" $jpeg_version %jpeg7 %jpeg8

if release                Compiler.Flags -O3

Linker.Flags              

Includes                  . gen

Defines
[
    JPEG_LIB_VERSION=$jpeg_version
    PACKAGE_NAME=\"libjpeg-turbo\"
    BUILD=\"%(_timestamp)\"
    VERSION=\"$(Version)\"
    NDEBUG
    INLINE=inline
    BITS_IN_JSAMPLE=$(bits_jsample)
]

Defines:!simd USE_CLZ_INTRINSIC

if _bit == 32 Defines SIZEOF_SIZE_T=4
if _bit == 64 Defines SIZEOF_SIZE_T=8

if bits_jsample == 8
{
    Defines
    [
        C_ARITH_CODING_SUPPORTED=%!no_arith_encode
        D_ARITH_CODING_SUPPORTED=%!no_arith_decode
    ]
}

if clang|gcc
{
    Defines
    [
        HIDDEN=__attribute__((visibility(\"hidden\")))
        FORCE_INLINE=__attribute__((always_inline))
        THREAD_LOCAL=__thread
    ]
}

if msvc
{
    Defines
    [
        FORCE_INLINE=__forceinline
        THREAD_LOCAL=__declspec(thread)
        HAVE_INTRIN_H=1
    ]
}

if jpeg_version == 62
{
    Defines
    [
        JPEG_LIB_VERSION_DECIMAL=6.2
        DEFAULT_SO_MAJOR_VERSION=6
        DEFAULT_SO_MINOR_VERSION=0
    ]
}

if jpeg_version == 80
{

    Defines
    [
        JPEG_LIB_VERSION_DECIMAL=8.0
        DEFAULT_SO_MAJOR_VERSION=8
        DEFAULT_SO_MINOR_VERSION=2
    ]
}

if jpeg_version == 70
{
    Defines
    [
        JPEG_LIB_VERSION_DECIMAL=7.0
        DEFAULT_SO_MAJOR_VERSION=7
        DEFAULT_SO_MINOR_VERSION=0
    ]
}

if target starts_with turbojpeg
{
    Defines BMP_SUPPORTED PPM_SUPPORTED
}

##
PreBuild.NewDirectory gen
PreBuild.Copy jconfig.txt         gen/jconfig.h
PreBuild.Copy jversion.h.in       gen/jversion.h
PreBuild.Copy jconfigint.h.in.new gen/jconfigint.h
##

# -- Options --------------------------------------------------------

option.target(jpeg jpeg12 jpeg16 turbojpeg turbojpeg12 turbojpeg16)

option.jpeg8                 Emulate libjpeg v8 API/ABI
option.jpeg7                 Emulate libjpeg v7 API/ABI
option.simd(on off)          Enable or Disable SIMD acceleration
option.no_arith_encode       Disable arithmetic encoding
option.no_arith_decode       Disable arithmetic decoding
option.bits_in_jsample(8 12) Only 8 and 12 bit samples are legal data precisions for lossy JPEG according to the JPEG standard, and the IJG code does not support anything other than these two!

# -- Help  --------------------------------------------------------
.Help
{
    To build all targets, just run: riftbuild

    To build a single target, just run: riftbuild libjpeg.build target=VALUE
      where VALUE is any one of the following:
        - jpeg
        - jpeg12
        - jpeg16
        - turbojpeg
        - turbojpeg12
        - turbojpeg16
}

