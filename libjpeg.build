TargetName %target

Assembly $TargetName
Type     static_lib

TitleName        libjpeg-turbo
Description      libjpeg API DLL
InternalName     jpeg$(jpeg_version)
Version          3.1.3
CompanyName      libjpeg-turbo
Copyright        Copyright 1991-&date.year The libjpeg-turbo Project and many others

Compiler:windows cl
Compiler:unix    clang
Assembler        nasm

BuildDirectory            bin/$assembly
IntermediateDirectory     int/$assembly

SrcDir  src
WrapDir src/wrapper

Precision_Sources
[
    *-8.c
    *-12.c
    *-16.c
]

Program_Wrappers
[
    $WrapDir/rdcolmap-8.c
    $WrapDir/rdcolmap-12.c
    $WrapDir/wrgif-8.c
    $WrapDir/wrgif-12.c
]

SourceFiles.Exclude $Program_Wrappers

Ppm_Wrappers
[
    $WrapDir/rdppm-8.c
    $WrapDir/rdppm-12.c
    $WrapDir/rdppm-16.c
    $WrapDir/wrppm-8.c
    $WrapDir/wrppm-12.c
    $WrapDir/wrppm-16.c
]

Jpeg_Sources
[
    $Precision_Sources
    $SrcDir/jcapimin.c
    $SrcDir/jchuff.c
    $SrcDir/jcicc.c
    $SrcDir/jcinit.c
    $SrcDir/jclhuff.c
    $SrcDir/jcmarker.c
    $SrcDir/jcmaster.c
    $SrcDir/jcomapi.c
    $SrcDir/jcparam.c
    $SrcDir/jcphuff.c
    $SrcDir/jctrans.c
    $SrcDir/jdapimin.c
    $SrcDir/jdatadst.c
    $SrcDir/jdatasrc.c
    $SrcDir/jdhuff.c
    $SrcDir/jdicc.c
    $SrcDir/jdinput.c
    $SrcDir/jdlhuff.c
    $SrcDir/jdmarker.c
    $SrcDir/jdmaster.c
    $SrcDir/jdphuff.c
    $SrcDir/jdtrans.c
    $SrcDir/jerror.c
    $SrcDir/jfdctflt.c
    $SrcDir/jmemmgr.c
    $SrcDir/jmemnobs.c
    $SrcDir/jpeg_nbits.c
]

if !no_arith_encode Jpeg_Sources $SrcDir/jcarith.c
if !no_arith_decode Jpeg_Sources $SrcDir/jdarith.c
if !no_arith_encode Jpeg_Sources $SrcDir/jaricom.c
if no_arith_encode if !no_arith_decode Jpeg_Sources $SrcDir/jaricom.c

TurboJpeg_Sources
[
    $Jpeg_Sources
    $SrcDir/turbojpeg.c
    $SrcDir/transupp.c
    $SrcDir/jdatadst-tj.c
    $SrcDir/jdatasrc-tj.c
    $SrcDir/rdbmp.c
    $SrcDir/wrbmp.c
]

if target == turbojpeg  SourceFiles $TurboJpeg_Sources
if target != turbojpeg  SourceFiles $Jpeg_Sources
if target != turbojpeg  SourceFiles.Exclude $Ppm_Wrappers

if simd
{
    Compiler.Defines WITH_SIMD

    SourceFiles $(SimdDir)/jsimd.c

    Assembler.Flags -Isimd/nasm -I$SimdDir

    if windows if x86_64  Assembler.Flags -DWIN64 -D__x86_64__ -f win64
    if windows if !x86_64 Assembler.Flags -DWIN32 -f win32

    if x86_64   SimdDir simd/x86_64
    if x86 if !x86_64 SimdDir simd/i386
    if mips     SimdDir simd/mips
    if mips64   SimdDir simd/mips64
    if powerpc  SimdDir simd/powerpc

    SourceFiles
    [
        $(SimdDir)/jsimdcpu.asm
        $(SimdDir)/jfdctflt-sse.asm
        $(SimdDir)/jccolor-sse2.asm
        $(SimdDir)/jcgray-sse2.asm
        $(SimdDir)/jchuff-sse2.asm
        $(SimdDir)/jcphuff-sse2.asm
        $(SimdDir)/jcsample-sse2.asm
        $(SimdDir)/jdcolor-sse2.asm
        $(SimdDir)/jdmerge-sse2.asm
        $(SimdDir)/jdsample-sse2.asm
        $(SimdDir)/jfdctfst-sse2.asm
        $(SimdDir)/jfdctint-sse2.asm
        $(SimdDir)/jidctflt-sse2.asm
        $(SimdDir)/jidctfst-sse2.asm
        $(SimdDir)/jidctint-sse2.asm
        $(SimdDir)/jidctred-sse2.asm
        $(SimdDir)/jquantf-sse2.asm
        $(SimdDir)/jquanti-sse2.asm
        $(SimdDir)/jccolor-avx2.asm
        $(SimdDir)/jcgray-avx2.asm
        $(SimdDir)/jcsample-avx2.asm
        $(SimdDir)/jdcolor-avx2.asm
        $(SimdDir)/jdmerge-avx2.asm
        $(SimdDir)/jdsample-avx2.asm
        $(SimdDir)/jfdctint-avx2.asm
        $(SimdDir)/jidctint-avx2.asm
        $(SimdDir)/jquanti-avx2.asm
    ]
}

if !jpeg8 if !jpeg7       jpeg_version 62 ; jpeg_version_decimal 6.2
if jpeg8                  jpeg_version 80 ; jpeg_version_decimal 8.0
if jpeg7                  jpeg_version 70 ; jpeg_version_decimal 7.0

if release                Compiler.Flags -O3

Linker.Flags              

Compiler.Includes         . gen

Compiler.Defines          NDEBUG

if target starts_with turbojpeg Compiler.Defines BMP_SUPPORTED PPM_SUPPORTED

copyright_year                1991-&date.year
libjpeg_turbo_version_number  3001003

if msvc
{
    inline_kw       __forceinline
    thread_local_kw __declspec(thread)
    have_intrin_line \#define HAVE_INTRIN_H
}
else
{
    inline_kw       inline __attribute__((always_inline))
    thread_local_kw __thread
}

if windows
{
    hidden_line \#define HIDDEN
}
else
{
    hidden_line \#define HIDDEN  __attribute__((visibility("hidden")))

    # HAVE_BUILTIN_CTZL needs sizeof(unsigned long) == sizeof(size_t). Windows is
    # LLP64, so unsigned long stays 4 bytes there and the probe fails.
    if clang|gcc
    {
        have_ctzl_line \#define HAVE_BUILTIN_CTZL
    }
}


if !no_arith_encode c_arith_line \#define C_ARITH_CODING_SUPPORTED 1
if !no_arith_decode d_arith_line \#define D_ARITH_CODING_SUPPORTED 1

if simd with_simd_line \#define WITH_SIMD 1

PreBuild.NewDir gen

PreBuild.WriteFile gen/jconfig.h
{
    \#define JPEG_LIB_VERSION  $jpeg_version
    \#define LIBJPEG_TURBO_VERSION  $(Version)
    \#define LIBJPEG_TURBO_VERSION_NUMBER  $libjpeg_turbo_version_number
    $c_arith_line
    $d_arith_line
    \#define MEM_SRCDST_SUPPORTED  1
    $with_simd_line
    \#ifndef BITS_IN_JSAMPLE
    \#define BITS_IN_JSAMPLE  8
    \#endif
    \#ifdef _WIN32
    \#undef RIGHT_SHIFT_IS_UNSIGNED
    \#ifndef __RPCNDR_H__
    typedef unsigned char boolean;
    \#endif
    \#define HAVE_BOOLEAN
    \#if \!(defined(_BASETSD_H_) || defined(_BASETSD_H))
    typedef short INT16;
    typedef signed int INT32;
    \#endif
    \#define XMD_H
    \#endif
}

PreBuild.WriteFile gen/jconfigint.h
{
    \#define BUILD  "&Date.NoSep"
    $hidden_line
    \#undef inline
    \#define INLINE  $inline_kw
    \#define THREAD_LOCAL  $thread_local_kw
    \#define PACKAGE_NAME  "libjpeg-turbo"
    \#define VERSION  "$(Version)"
    \#define SIZEOF_SIZE_T  &sizeof.size_t
    $have_ctzl_line
    $have_intrin_line
    \#if defined(_MSC_VER) && defined(HAVE_INTRIN_H)
    \#if (SIZEOF_SIZE_T == 8)
    \#define HAVE_BITSCANFORWARD64
    \#elif (SIZEOF_SIZE_T == 4)
    \#define HAVE_BITSCANFORWARD
    \#endif
    \#endif
    \#if defined(__has_attribute)
    \#if __has_attribute(fallthrough)
    \#define FALLTHROUGH  __attribute__((fallthrough));
    \#else
    \#define FALLTHROUGH
    \#endif
    \#else
    \#define FALLTHROUGH
    \#endif
    \#ifndef BITS_IN_JSAMPLE
    \#define BITS_IN_JSAMPLE  8
    \#endif
    \#undef C_ARITH_CODING_SUPPORTED
    \#undef D_ARITH_CODING_SUPPORTED
    \#undef WITH_SIMD
    \#if BITS_IN_JSAMPLE == 8
    $c_arith_line
    $d_arith_line
    $with_simd_line
    \#endif
}

PreBuild.WriteFile gen/jversion.h
{
    \#if JPEG_LIB_VERSION >= 80
    \#define JVERSION  "8d  15-Jan-2012"
    \#elif JPEG_LIB_VERSION >= 70
    \#define JVERSION  "7  27-Jun-2009"
    \#else
    \#define JVERSION  "6b  27-Mar-1998"
    \#endif

    \#define JCOPYRIGHT1 \\
    "Copyright (C) 2009-2024 D. R. Commander\\n" \\
    "Copyright (C) 2015, 2020 Google, Inc.\\n" \\
    "Copyright (C) 2019-2020 Arm Limited\\n" \\
    "Copyright (C) 2015-2016, 2018 Matthieu Darbois\\n" \\
    "Copyright (C) 2011-2016 Siarhei Siamashka\\n" \\
    "Copyright (C) 2015 Intel Corporation\\n"

    \#define JCOPYRIGHT2 \\
    "Copyright (C) 2013-2014 Linaro Limited\\n" \\
    "Copyright (C) 2013-2014 MIPS Technologies, Inc.\\n" \\
    "Copyright (C) 2009, 2012 Pierre Ossman for Cendio AB\\n" \\
    "Copyright (C) 2009-2011 Nokia Corporation and/or its subsidiary(-ies)\\n" \\
    "Copyright (C) 1999-2006 MIYASAKA Masaru\\n" \\
    "Copyright (C) 1999 Ken Murchison\\n" \\
    "Copyright (C) 1991-2020 Thomas G. Lane, Guido Vollbeding\\n"

    \#define JCOPYRIGHT_SHORT \\
    "Copyright (C) $copyright_year The libjpeg-turbo Project and many others"
}

# -- Options --------------------------------------------------------

option.target(jpeg turbojpeg)

option.jpeg8                 Emulate libjpeg v8 API/ABI
option.jpeg7                 Emulate libjpeg v7 API/ABI
option.simd(on off)          Enable or Disable SIMD acceleration
option.no_arith_encode       Disable arithmetic encoding
option.no_arith_decode       Disable arithmetic decoding

# -- Help  --------------------------------------------------------
.Help
{
    To build all targets, just run: riftbuild

    To build a single target, just run: riftbuild libjpeg.build target=VALUE
      where VALUE is any one of the following:
        - jpeg
        - turbojpeg
}

